<%- include("partials/header") %>

<section class="hero">
  <div>
    <p class="eyebrow">Inventory Management</p>
    <h1>Computer Store Inventory</h1>
    <p>
      Kelola kategori dan seluruh produk inventory dari satu tempat.
    </p>
  </div>
</section>

<section class="stats">
  <div class="stat-card">
    <span>Categories</span>
    <strong><%= categories.length %></strong>
  </div>

  <div class="stat-card">
    <span>Items</span>
    <strong><%= items.length %></strong>
  </div>

  <div class="stat-card">
    <span>Total Stock</span>
    <strong>
      <%= items.reduce((total, item) => total + Number(item.quantity), 0) %>
    </strong>
  </div>
</section>

<section class="section-header">
  <div>
    <h2>Categories</h2>
    <p>Pilih kategori untuk melihat produknya.</p>
  </div>

  <a href="/categories/new" class="button">
    Add Category
  </a>
</section>

<div class="card-grid">
  <% categories.forEach((category) => { %>
    <a
      href="/categories/<%= category.id %>"
      class="card"
    >
      <h3><%= category.name %></h3>

      <p>
        <%= category.description || "No description." %>
      </p>

      <span class="badge">
        <%= category.item_count %> items
      </span>
    </a>
  <% }) %>
</div>

<section class="section-header">
  <div>
    <h2>Latest Inventory</h2>
    <p>Daftar seluruh item yang tersedia.</p>
  </div>

  <a href="/items/new" class="button">
    Add Item
  </a>
</section>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock</th>
      </tr>
    </thead>

    <tbody>
      <% items.forEach((item) => { %>
        <tr>
          <td>
            <a href="/items/<%= item.id %>">
              <%= item.name %>
            </a>
          </td>

          <td>
            <%= item.category_name %>
          </td>

          <td>
            Rp <%= Number(item.price).toLocaleString("id-ID") %>
          </td>

          <td>
            <%= item.quantity %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("partials/footer") %>